{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Orleans": "Information",
      "OrderProcessing": "Debug"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
    }
  },
  "OrderProcessing": {
    "EnableDetailedLogging": true,
    "MaxConcurrentOrders": 100,
    "WorkflowTimeoutMinutes": 30,
    "Validation": {
      "MinValidationScore": 30,
      "ValidationTimeoutSeconds": 10,
      "EnableStrictValidation": false
    },
    "Approval": {
      "MinApprovalScore": 20,
      "AutoApprovalThreshold": 1000.00,
      "ApprovalTimeoutSeconds": 30
    }
  },
  "BusinessRules": {
    "OrderValidation": {
      "EnableInventoryCheck": true,
      "EnableCreditCheck": true,
      "EnableProductAvailabilityCheck": true,
      "MinOrderAmount": 0.01,
      "MaxOrderAmount": 100000.00
    },
    "WorkflowSteps": {
      "ValidationStep": {
        "Enabled": true,
        "TimeoutSeconds": 30,
        "RetryCount": 3
      },
      "ApprovalStep": {
        "Enabled": true,
        "TimeoutSeconds": 60,
        "RetryCount": 2
      },
      "ProcessingStep": {
        "Enabled": true,
        "TimeoutSeconds": 120,
        "RetryCount": 1
      },
      "CompletionStep": {
        "Enabled": true,
        "TimeoutSeconds": 15,
        "RetryCount": 1
      }
    }
  },
  "Performance": {
    "EnableMetrics": true,
    "MetricsUpdateIntervalSeconds": 30,
    "EnableHealthChecks": true,
    "GrainCollectionIntervalMinutes": 10
  },
  "Development": {
    "EnableSwagger": true,
    "EnableDetailedErrors": true,
    "EnableDeveloperExceptionPage": true
  }
} 