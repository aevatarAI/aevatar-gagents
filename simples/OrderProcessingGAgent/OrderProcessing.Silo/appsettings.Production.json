{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Error",
      "Microsoft.Hosting.Lifetime": "Information",
      "Orleans": "Warning",
      "OrderProcessing": "Information"
    }
  },
  "OrderProcessing": {
    "EnableDetailedLogging": false,
    "MaxConcurrentOrders": 1000,
    "WorkflowTimeoutMinutes": 60,
    "Validation": {
      "MinValidationScore": 50,
      "ValidationTimeoutSeconds": 5,
      "EnableStrictValidation": true
    },
    "Approval": {
      "MinApprovalScore": 30,
      "AutoApprovalThreshold": 2000.00,
      "ApprovalTimeoutSeconds": 15
    }
  },
  "Development": {
    "EnableSwagger": false,
    "EnableDetailedErrors": false,
    "EnableDeveloperExceptionPage": false
  },
  "Performance": {
    "EnableMetrics": true,
    "MetricsUpdateIntervalSeconds": 60,
    "EnableHealthChecks": true,
    "GrainCollectionIntervalMinutes": 30
  },
  "Security": {
    "EnableAuthentication": true,
    "EnableAuthorization": true,
    "RequireHttps": true
  }
} 