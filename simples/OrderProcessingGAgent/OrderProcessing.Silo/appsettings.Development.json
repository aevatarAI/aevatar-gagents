{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Orleans": "Debug",
      "OrderProcessing": "Trace"
    }
  },
  "OrderProcessing": {
    "EnableDetailedLogging": true,
    "MaxConcurrentOrders": 50,
    "WorkflowTimeoutMinutes": 10,
    "Validation": {
      "MinValidationScore": 20,
      "ValidationTimeoutSeconds": 30,
      "EnableStrictValidation": true
    },
    "Approval": {
      "MinApprovalScore": 10,
      "AutoApprovalThreshold": 500.00,
      "ApprovalTimeoutSeconds": 60
    }
  },
  "Development": {
    "EnableSwagger": true,
    "EnableDetailedErrors": true,
    "EnableDeveloperExceptionPage": true
  },
  "Performance": {
    "EnableMetrics": true,
    "MetricsUpdateIntervalSeconds": 10,
    "EnableHealthChecks": true,
    "GrainCollectionIntervalMinutes": 5
  }
} 